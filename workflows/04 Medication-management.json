      "id": "54dc65e4-046d-4c01-8460-9a27a1fe1c33",
      "name": "Webhook - Add Medication",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -656,
        64
      ],
      "webhookId": "medications-post"
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\nconst b = input.body || input;\n\nconst required = [\n  'user_id',\n  'medicine_name',\n  'dosage',\n  'frequency',\n  'reminder_time',\n  'start_date'\n];\n\nconst missing = required.filter(\n  field =>\n    b[field] === undefined ||\n    b[field] === null ||\n    String(b[field]).trim() === ''\n);\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: `Missing: ${missing.join(', ')}`\n    }\n  }];\n}\n\n// Normalize reminder time\nlet reminderTime = String(b.reminder_time).trim();\n\n// Convert HH:MM to HH:MM:SS\nif (/^\\d{2}:\\d{2}$/.test(reminderTime)) {\n  reminderTime += ':00';\n}\n\n// Validate HH:MM:SS\nif (!/^\\d{2}:\\d{2}:\\d{2}$/.test(reminderTime)) {\n  return [{\n    json: {\n      valid: false,\n      error: 'reminder_time must be in HH:MM or HH:MM:SS format'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    user_id: String(b.user_id).trim(),\n    medicine_name: String(b.medicine_name).trim(),\n    dosage: String(b.dosage).trim(),\n    frequency: String(b.frequency).trim(),\n    reminder_time: reminderTime,\n    start_date: String(b.start_date).trim(),\n    end_date:\n      b.end_date && String(b.end_date).trim() !== ''\n        ? String(b.end_date).trim()\n        : null\n  }\n}];"
      },
