    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\n// Accept data whether n8n puts it inside \"body\" or directly in the item\nconst b = input.body ?? input;\n\nconst required = [\n  'name',\n  'email',\n  'phone',\n  'date_of_birth',\n  'gender',\n  'blood_group'\n];\n\nconst missing = required.filter(\n  field => b[field] === undefined || b[field] === null || String(b[field]).trim() === ''\n);\n\nif (missing.length > 0) {\n  return [{\n    json: {\n      valid: false,\n      error: `Missing fields: ${missing.join(', ')}`\n    }\n  }];\n}\n\nconst email = String(b.email).trim().toLowerCase();\n\nconst emailOk = /^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$/.test(email);\n\nif (!emailOk) {\n  return [{\n    json: {\n      valid: false,\n      error: 'Invalid email format'\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    name: String(b.name).trim(),\n    email: email,\n    phone: String(b.phone).trim(),\n    date_of_birth: b.date_of_birth,\n    gender: String(b.gender).trim(),\n    blood_group: String(b.blood_group).trim()\n  }\n}];"
      },
